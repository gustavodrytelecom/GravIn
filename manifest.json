{
  "manifest_version": 3,
  "name": "GravIn",
  "version": "1.0.0",
  "description": "Grava a aba já recortada no tamanho do dispositivo selecionado no DevTools e salva o vídeo numa pasta definida.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GravIn — gravar viewport",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Iniciar/parar gravação"
    }
  }
}
